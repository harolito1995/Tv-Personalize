<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/personalizeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top bar: Title + active search chip + Search (icon only) + Filter + Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/personalize"
                android:textColor="#FFFFFFFF"
                android:textSize="30sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 300"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/chipActiveSearch"
                style="@style/TopButton"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="6dp"
                android:maxWidth="320dp"
                android:singleLine="true"
                android:ellipsize="middle"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnSearch"
                style="@style/IconButton"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search_chip" />

            <ImageView
                android:id="@+id/btnFilter"
                style="@style/IconButton"
                android:src="@drawable/ic_filter"
                android:contentDescription="@string/filter_title" />

            <ImageView
                android:id="@+id/btnSettings"
                style="@style/IconButton"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Wallpaper catalogue: categories, results and explicit pagination. -->
            <LinearLayout
                android:id="@+id/catalogPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false">

                <HorizontalScrollView
                    android:id="@+id/catScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:scrollbars="none"
                    android:focusable="false"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:id="@+id/cats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/grid"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp"
                        android:clipToPadding="false"
                        android:clipChildren="false"
                        android:overScrollMode="never"
                        android:scrollbars="none" />
                </FrameLayout>

                <!-- Clean pagination: previous icon, page indicator, next icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/btnPrev"
                        style="@style/IconButton"
                        android:layout_marginStart="0dp"
                        android:src="@drawable/ic_move_left"
                        android:contentDescription="@string/page_prev" />

                    <TextView
                        android:id="@+id/pageLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="#8CFFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:letterSpacing="0.08" />

                    <ImageView
                        android:id="@+id/btnNext"
                        style="@style/IconButton"
                        android:src="@drawable/ic_move_right"
                        android:contentDescription="@string/page_next" />
                </LinearLayout>
            </LinearLayout>

            <!-- Settings: themes, dock, weather, screensaver and local files. -->
            <LinearLayout
                android:id="@+id/settingsPanel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:visibility="gone">

                <TextView
                    android:id="@+id/labelThemes"
                    style="@style/SectionLabel"
                    android:text="@string/personalize_themes" />

                <HorizontalScrollView
                    android:id="@+id/themeScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:scrollbars="none"
                    android:focusable="false"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:id="@+id/themeRail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clipChildren="false"
                        android:clipToPadding="false" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/labelInterface"
                        style="@style/SectionLabel"
                        android:text="@string/personalize_interface" />

                    <TextView
                        android:id="@+id/chipDockBand"
                        style="@style/TopButton"
                        android:layout_marginStart="14dp"
                        android:text="@string/dock_style_band" />

                    <TextView
                        android:id="@+id/chipDockFloat"
                        style="@style/TopButton"
                        android:text="@string/dock_style_floating" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/labelWeather"
                        style="@style/SectionLabel"
                        android:text="@string/weather_title" />

                    <TextView
                        android:id="@+id/chipWeatherOn"
                        style="@style/TopButton"
                        android:layout_marginStart="14dp"
                        android:text="Activado" />

                    <TextView
                        android:id="@+id/chipWeatherOff"
                        style="@style/TopButton"
                        android:text="Desactivado" />

                    <TextView
                        android:id="@+id/weatherAttribution"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="220dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:layout_marginStart="16dp"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp"
                        android:fontFamily="@font/outfit"
                        android:text="@string/weather_attribution" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/labelDream"
                        style="@style/SectionLabel"
                        android:text="@string/personalize_dream" />

                    <TextView
                        android:id="@+id/btnDreamPick"
                        style="@style/TopButton"
                        android:layout_marginStart="14dp"
                        android:text="@string/dream_pick"
                        android:drawableStart="@drawable/ic_image" />

                    <TextView
                        android:id="@+id/btnDreamReset"
                        style="@style/TopButton"
                        android:text="@string/dream_use_wallpaper" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/labelWallpapers"
                        style="@style/SectionLabel"
                        android:text="@string/personalize_wallpapers" />

                    <TextView
                        android:id="@+id/btnNone"
                        style="@style/TopButton"
                        android:layout_marginStart="14dp"
                        android:text="@string/wallpaper_none"
                        android:drawableStart="@drawable/ic_play" />

                    <TextView
                        android:id="@+id/btnScan"
                        style="@style/TopButton"
                        android:text="@string/wallpaper_scan"
                        android:drawableStart="@drawable/ic_refresh" />

                    <TextView
                        android:id="@+id/btnPick"
                        style="@style/TopButton"
                        android:text="@string/wallpaper_pick"
                        android:drawableStart="@drawable/ic_image" />
                </LinearLayout>

                <TextView
                    android:id="@+id/settingsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/outfit"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="2dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/settingsGrid"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingTop="4dp"
                        android:paddingBottom="12dp"
                        android:clipToPadding="false"
                        android:clipChildren="false"
                        android:overScrollMode="never"
                        android:scrollbars="none" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
