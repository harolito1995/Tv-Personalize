<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="@drawable/preview_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:paddingBottom="26dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 300"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_tertiary"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:letterSpacing="0.01"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:fontFamily="@font/outfit"
            android:maxLines="1"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:lineSpacingMultiplier="1.2" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnApply"
                style="@style/TopButton"
                android:layout_marginStart="0dp"
                android:text="@string/preview_apply"
                android:drawableStart="@drawable/ic_star" />

            <TextView
                android:id="@+id/btnApplyDream"
                style="@style/TopButton"
                android:text="@string/preview_apply_dream"
                android:drawableStart="@drawable/ic_moon" />

            <TextView
                android:id="@+id/btnFavorite"
                style="@style/TopButton"
                android:text="@string/preview_favorite_add"
                android:drawableStart="@drawable/ic_star" />

            <TextView
                android:id="@+id/btnBack"
                style="@style/TopButton"
                android:text="@string/preview_back" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
