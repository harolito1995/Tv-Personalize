<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen theme preview: a mock of the B.3 home screen (compact header with clock/date/weather,
     2 compact 148x83dp Continue Watching cards, Dock row, and Apply/Back controls) painted with the
     theme's real palette in ThemePreviewActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/themeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/scrimTop"
        android:layout_width="match_parent"
        android:layout_height="@dimen/scrim_top_height"
        android:layout_gravity="top" />

    <View
        android:id="@+id/scrimBottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/scrim_bottom_height"
        android:layout_gravity="bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Header matching MainActivity B.3: clock, date, weather pill on left; 3 sphere icons on right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextClock
                    android:id="@+id/mockClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="H:mm"
                    android:textSize="32sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 300"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="false"
                    android:singleLine="true" />

                <TextClock
                    android:id="@+id/mockDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:format12Hour="@string/date_format"
                    android:format24Hour="@string/date_format"
                    android:textSize="15sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 400"
                    android:singleLine="true" />

                <LinearLayout
                    android:id="@+id/mockWeatherPill"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/weather_capsule_bg"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="9dp"
                    android:paddingEnd="11dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_weather_sun_cloud"
                        android:scaleType="centerInside"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/mockWeatherText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="14°C"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- Kept gone for compatibility -->
                <TextView
                    android:id="@+id/mockGreeting"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
                <TextClock
                    android:id="@+id/mockAmpm"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mockPills"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    style="@style/HeaderSphere"
                    android:focusable="false"
                    android:clickable="false">
                    <ImageView
                        style="@style/HeaderSphereIcon"
                        android:src="@drawable/ic_input" />
                </FrameLayout>

                <FrameLayout
                    style="@style/HeaderSphere"
                    android:focusable="false"
                    android:clickable="false">
                    <ImageView
                        style="@style/HeaderSphereIcon"
                        android:src="@drawable/ic_settings" />
                </FrameLayout>

                <FrameLayout
                    style="@style/HeaderSphere"
                    android:focusable="false"
                    android:clickable="false">
                    <ImageView
                        style="@style/HeaderSphereIcon"
                        android:src="@drawable/ic_wifi" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Continue Watching section matching B.3 -->
        <TextView
            android:id="@+id/mockShelfLabel"
            style="@style/SectionLabel"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:textSize="14sp"
            android:letterSpacing="0.06"
            android:fontVariationSettings="'wght' 600"
            android:text="@string/top_shelf_title" />

        <LinearLayout
            android:id="@+id/mockShelfRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Theme Hero Title & Tagline -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mockHero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="40sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 300"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>

        <!-- Mock Dock matching B.3 -->
        <FrameLayout
            android:id="@+id/mockDockWrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/mockDockCards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false" />
        </FrameLayout>

        <!-- Action bar: Apply theme, Back, and status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnApply"
                style="@style/TopButton"
                android:layout_marginStart="0dp"
                android:text="@string/theme_apply"
                android:drawableStart="@drawable/ic_star" />

            <TextView
                android:id="@+id/btnBack"
                style="@style/TopButton"
                android:text="@string/preview_back" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:textSize="14sp"
                android:fontFamily="@font/outfit" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
