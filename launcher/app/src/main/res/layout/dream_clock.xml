<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver: the Home wallpaper full screen, with a quiet clock and date over a bottom scrim. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/dreamPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26000000" />

    <View
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:id="@+id/dreamContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="72dp"
        android:layout_marginBottom="64dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/dreamClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 200"
                android:format12Hour="h:mm"
                android:format24Hour="HH:mm"
                android:includeFontPadding="false"
                android:letterSpacing="-0.04"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="10"
                android:textColor="#F2FFFFFF"
                android:textSize="64sp" />

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:format12Hour="a"
                android:format24Hour=""
                android:includeFontPadding="false"
                android:letterSpacing="0.08"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="10"
                android:textAllCaps="true"
                android:textColor="#B3FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <TextClock
            android:id="@+id/dreamDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:format12Hour="EEEE  d MMMM"
            android:format24Hour="EEEE  d MMMM"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="10"
            android:textAllCaps="true"
            android:textColor="#B3FFFFFF"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>
