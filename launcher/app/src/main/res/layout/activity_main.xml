<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Active wallpaper (image or muted video), covered by contrast scrims below. -->
    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <VideoView
        android:id="@+id/wallpaperVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/wallpaperDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2E000000"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/scrimTop"
        android:layout_width="match_parent"
        android:layout_height="@dimen/scrim_top_height"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />

    <View
        android:id="@+id/scrimBottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/scrim_bottom_height"
        android:layout_gravity="bottom"
        android:background="@drawable/scrim_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingBottom="28dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Header: clock, date and weather on left; Inputs, Settings, Wi-Fi on right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 300"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="false"
                    android:format12Hour="h:mm"
                    android:format24Hour="H:mm"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 400"
                    android:singleLine="true" />

                <LinearLayout
                    android:id="@+id/weatherPill"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/weather_capsule_bg"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="9dp"
                    android:paddingEnd="11dp">

                    <ImageView
                        android:id="@+id/weatherIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_weather_sun_cloud"
                        android:scaleType="centerInside"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/weatherText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxWidth="160dp"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:singleLine="true"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Top right action icons: sleek circular borders matching Image 1 -->
            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:id="@+id/btnInputs"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/top_bar_btn_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/inputs">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:scaleType="centerInside"
                        android:duplicateParentState="true"
                        android:tint="@drawable/pill_text"
                        android:src="@drawable/ic_input" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/top_bar_btn_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/settings">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:scaleType="centerInside"
                        android:duplicateParentState="true"
                        android:tint="@drawable/pill_text"
                        android:src="@drawable/ic_settings" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/btnWifi"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/top_bar_btn_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/wifi">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:scaleType="centerInside"
                        android:duplicateParentState="true"
                        android:tint="@drawable/pill_text"
                        android:src="@drawable/ic_wifi" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Continue watching header: clean single play symbol from string -->
        <TextView
            android:id="@+id/topShelfLabel"
            style="@style/SectionLabel"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:textSize="14sp"
            android:letterSpacing="0.06"
            android:fontVariationSettings="'wght' 600"
            android:textColor="@color/text_primary"
            android:text="@string/top_shelf_title" />

        <LinearLayout
            android:id="@+id/topShelfRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <!-- Flexible space between Top Shelf and Dock, keeping both properly balanced -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Dock: favourite apps. All apps and launcher tools are in the bottom bar. -->
        <LinearLayout
            android:id="@+id/dockRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <!-- Bottom actions: one Apps pill, then compact icon-and-label tools. -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnApps"
                style="@style/AppsPill"
                android:drawableStart="@drawable/ic_apps"
                android:text="@string/nav_apps" />

            <View
                android:id="@+id/bottomDivider1"
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="36dp"
                android:background="@color/divider_faint" />

            <LinearLayout
                android:id="@+id/btnSearch"
                style="@style/ToolButton"
                android:layout_marginStart="45dp"
                android:contentDescription="@string/nav_search">

                <FrameLayout
                    android:id="@+id/btnSearchCircle"
                    style="@style/ToolCircle">

                    <ImageView
                        android:id="@+id/btnSearchIcon"
                        style="@style/ToolIcon"
                        android:src="@drawable/ic_search" />
                </FrameLayout>

                <TextView
                    android:id="@+id/btnSearchLabel"
                    style="@style/ToolLabel"
                    android:text="@string/nav_search" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPersonalize"
                style="@style/ToolButton"
                android:layout_marginStart="34dp"
                android:contentDescription="@string/personalize">

                <FrameLayout
                    android:id="@+id/btnPersonalizeCircle"
                    style="@style/ToolCircle">

                    <ImageView
                        android:id="@+id/btnPersonalizeIcon"
                        style="@style/ToolIcon"
                        android:src="@drawable/ic_sparkle" />
                </FrameLayout>

                <TextView
                    android:id="@+id/btnPersonalizeLabel"
                    style="@style/ToolLabel"
                    android:text="@string/personalize" />
            </LinearLayout>

            <View
                android:id="@+id/bottomDivider2"
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="15dp"
                android:background="@color/divider_faint" />

            <LinearLayout
                android:id="@+id/btnThemes"
                style="@style/ToolButton"
                android:layout_marginStart="18dp"
                android:contentDescription="@string/nav_themes">

                <FrameLayout
                    android:id="@+id/btnThemesCircle"
                    style="@style/ToolCircle">

                    <ImageView
                        android:id="@+id/btnThemesIcon"
                        style="@style/ToolIcon"
                        android:src="@drawable/ic_globe" />
                </FrameLayout>

                <TextView
                    android:id="@+id/btnThemesLabel"
                    style="@style/ToolLabel"
                    android:text="@string/nav_themes" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnWeather"
                style="@style/ToolButton"
                android:layout_marginStart="32dp"
                android:contentDescription="@string/weather_title">

                <FrameLayout
                    android:id="@+id/btnWeatherCircle"
                    style="@style/ToolCircle">

                    <ImageView
                        android:id="@+id/btnWeatherIcon"
                        style="@style/ToolIcon"
                        android:src="@drawable/ic_weather_sun_cloud" />
                </FrameLayout>

                <TextView
                    android:id="@+id/btnWeatherLabel"
                    style="@style/ToolLabel"
                    android:text="@string/weather_title" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
