<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <FrameLayout
        android:id="@+id/themeCard"
        android:layout_width="150dp"
        android:layout_height="84dp"
        android:background="@drawable/tile_bg"
        android:focusable="true"
        android:clickable="true">

        <com.gathin.tvhome.ThemeCardView
            android:id="@+id/themeMock"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/themeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="5dp"
            android:maxWidth="118dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:letterSpacing="0.02"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8" />

        <ImageView
            android:id="@+id/themeBadge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:padding="4dp"
            android:background="@drawable/pill_bg"
            android:src="@drawable/ic_star"
            android:tint="#FF111111"
            android:visibility="gone"
            android:contentDescription="@null" />
    </FrameLayout>
</FrameLayout>
