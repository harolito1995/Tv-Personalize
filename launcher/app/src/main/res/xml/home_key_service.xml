<?xml version="1.0" encoding="utf-8"?>
<!-- Keys only: no accessibilityEventTypes, so the system never calls into the launcher for accessibility
     events. stock_home_redirect is the exception: HomeKeyService adds typeWindowStateChanged at runtime. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/home_key_description" />