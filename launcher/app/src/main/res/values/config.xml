<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: run adb shell pm list packages on the TV.
-->
<resources>
    <!-- Tried in order when no standard settings handler is usable; each package must also be visible through queries in the manifest. -->
    <string-array name="settings_fallback_components" translatable="false">
        <item>com.tcl.settings/com.tcl.settings.ui.MainActivity</item>
        <item>com.xiaomi.mitv.settings/com.xiaomi.mitv.settings.entry.MainActivity</item>
        <item>com.amazon.tv.launcher/com.amazon.tv.launcher.ui.MainSettingsActivity</item>
        <item>com.android.tv.settings/com.android.tv.settings.MainSettings</item>
    </string-array>

    <!-- Apps pinned to the dock row, in this order (the row shows the first 7 that are installed). Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.disney.disneyplus</item>
        <item>com.disney.starplus</item>
        <item>com.directv.dtvlatam</item>
        <item>co.movistar.go</item>
        <item>com.rcntv.rcntv</item>
        <item>com.wbd.stream</item>
        <item>com.spotify.tv.android</item>
    </string-array>

    <!-- Apps allowed to keep playing audio after you press Home (music players). Every other app is
         paused when the home screen comes back. Needs the notification-listener access that
         build-and-install grants; without it the launcher can only send a generic pause. -->
    <string-array name="keep_playing_apps">
        <item>com.spotify.tv.android</item>
        <item>com.spotify.music</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.tv.oneworld.tvcenter</item>
        <item>com.apps.dtv</item>
        <item>com.apps.atv</item>
        <item>com.apps.passthrough</item>
        <item>com.android.tv.settings</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.apps.dtv</string>

    <!-- Columns in the All apps grid. -->
    <integer name="columns">4</integer>

    <!-- Wallpaper catalogue manifest (GitHub Pages). Example after publishing this repo's docs/:
         https://<user>.github.io/HarolHome-TV/wallpapers/catalog.json
         Leave empty to browse the bundled demo catalogue (no network needed). -->
    <string name="catalog_url" translatable="false" />
</resources>