<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E61A263B"
                android:endColor="#E60E1522" />
            <corners android:radius="@dimen/top_shelf_card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#B3131C2B"
                android:endColor="#B30A1019" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
            <corners android:radius="@dimen/top_shelf_card_radius" />
        </shape>
    </item>
</selector>