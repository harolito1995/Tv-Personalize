<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Wallpaper catalogue download (HTTPS manifests and images). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed on Android 10 to read the Wi-Fi network name; granted over adb at install time. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Wallpapers are picked from the TV's storage or a USB drive; granted over adb at install time. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Android TV Watch Next history, used only for real Continue Watching cards. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />

        <queries>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.tcl.settings" />
        <package android:name="com.xiaomi.mitv.settings" />
        <package android:name="com.amazon.tv.launcher" />
        <package android:name="com.android.tv.settings" />
        <package android:name="com.apps.dtv" />
        <package android:name="com.apps.passthrough" />
    </queries>
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.TvHome"
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Wallpaper picker, opened from the Personalize pill on the home screen. -->
        <activity
            android:name=".PersonalizeActivity"
            android:exported="true"
            android:label="@string/personalize"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape" />

        <!-- Theme preview, opened from the theme rail in PersonalizeActivity. -->
        <activity
            android:name=".ThemePreviewActivity"
            android:exported="false"
            android:label="@string/personalize"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape" />

        <!-- Catalogue wallpaper preview, opened from the remote grid in PersonalizeActivity. -->
        <activity
            android:name=".WallpaperPreviewActivity"
            android:exported="true"
            android:label="@string/personalize"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape" />

        <activity
            android:name=".DreamPhotoActivity"
            android:exported="false"
            android:label="@string/dream_pick_title"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape" />

        <activity
            android:name=".UsbFolderActivity"
            android:exported="false"
            android:label="@string/usb_folder_title"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape" />

        <!-- Gives BackgroundAudioGuard access to other apps' media sessions so it can pause apps that
             keep playing after Home. Reads no notifications. Enable with:
             adb shell cmd notification allow_listener com.harolhome.tv/com.harolhome.tv.MediaSessionListener -->
        <service
            android:name=".MediaSessionListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".AllAppsActivity"
            android:exported="false"
            android:label="@string/all_apps_title"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape" />

        <!-- Screensaver: pick it in Settings, or `settings put secure screensaver_components
             com.harolhome.tv/com.harolhome.tv.ClockDream` over adb. -->
        <service
            android:name=".ClockDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Home button redirect (stock_home_redirect). Opt-in: launcher\build-and-install.ps1 -HomeKeyService. -->
        <service
            android:name=".HomeKeyService"
            android:label="@string/home_key_name"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>
    </application>
</manifest>
